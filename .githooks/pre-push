#!/usr/bin/env bash
set -euo pipefail

echo "BLACKPROOF pre-push gate"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "BLACKPROOF pre-push blocked: working tree is not clean."
  echo
  git status --short
  echo
  echo "Commit or stash all changes before pushing."
  echo "This prevents local-only files from making the gate pass while GitHub receives an incomplete commit."
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
release_scope="editorial"
saw_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  saw_ref=1
  if [[ "$local_ref" != refs/heads/* || "$local_sha" == "$zero_sha" ]]; then
    release_scope="full"
    continue
  fi

  base_sha="$remote_sha"
  if [[ "$remote_sha" == "$zero_sha" ]]; then
    if ! base_sha="$(git merge-base "$local_sha" origin/main 2>/dev/null)"; then
      release_scope="full"
      continue
    fi
  fi

  classification="$(node scripts/classify-release-scope.mjs "$base_sha" "$local_sha" 2>/dev/null || true)"
  if [[ "$classification" != *'"scope":"editorial"'* ]]; then
    release_scope="full"
  fi
done

if [[ "$saw_ref" -eq 0 ]]; then
  release_scope="full"
fi

# Git exports repository-local variables to hooks. Test fixtures that create
# temporary repositories must not inherit them.
while read -r git_environment_name; do
  unset "$git_environment_name"
done < <(git rev-parse --local-env-vars)

if [[ "$release_scope" == "editorial" ]]; then
  echo "Editorial-only diff proven: running the bounded content gate."
  echo "Running: pnpm editorial:gate"
  pnpm editorial:gate
  echo "BLACKPROOF editorial pre-push gate passed"
  exit 0
fi

echo "Full gate required: the diff is not proven editorial-only."
echo "Running: pnpm check"
pnpm check

echo "Running: pnpm test"
pnpm test

echo "Running: pnpm build"
pnpm build

echo "Running: pnpm audit"
pnpm audit

echo "Running: pnpm security:audit"
pnpm security:audit

echo "BLACKPROOF pre-push gate passed"

---
import shareLinksScriptUrl from "../scripts/share-links.js?url";

interface Props {
  url: string;
  title: string;
  heading?: string;
  id?: string;
  variant?: "default" | "article";
  localWorkspace?: boolean;
}

const {
  url,
  title,
  heading = "Partager",
  id = "share",
  variant = "default",
  localWorkspace = false,
} = Astro.props;

const defaultSiteUrl = "https:" + "//blackproof.fr";
const siteUrl = Astro.site ?? defaultSiteUrl;
const publicUrl = new URL(url, siteUrl);
publicUrl.search = "";
publicUrl.hash = "";
const canonicalUrl = publicUrl.toString();
const shareText = `${title}\n${canonicalUrl}`;
const headingId = `${id}-heading`;

const socialLinks = [
  {
    name: "X",
    label: "Partager sur X",
    href: `https://x.com/intent/post?text=${encodeURIComponent(shareText)}`,
    icon: "x",
  },
  {
    name: "LinkedIn",
    label: "Partager sur LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`,
    icon: "linkedin",
  },
  {
    name: "Facebook",
    label: "Partager sur Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`,
    icon: "facebook",
  },
  {
    name: "Bluesky",
    label: "Partager sur Bluesky",
    href: `https://bsky.app/intent/compose?text=${encodeURIComponent(shareText)}`,
    icon: "bluesky",
  },
] as const;

const emailUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${title}\n\n${canonicalUrl}`)}`;
---

<section id={id} class:list={["share-panel", { "share-panel--article": variant === "article" }]} aria-labelledby={headingId} data-share-panel>
  <div class="share-intro">
    <h2 id={headingId}>{heading}</h2>
    <p>{localWorkspace ? "Le site uniquement, jamais vos dossiers." : "Aucun réseau n’est contacté avant votre clic."}</p>
  </div>

  <div class="share-actions" role="group" aria-label={heading}>
    {socialLinks.map((link) => (
      <a
        class="share-action"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer nofollow"
        referrerpolicy="no-referrer"
        aria-label={link.label}
        data-share-destination={link.icon}
      >
        <span class:list={["share-icon", `share-icon--${link.icon}`]} aria-hidden="true">
          {link.icon === "bluesky" ? (
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M5.1 5.2c2.8 2.1 5.8 6.2 6.9 8.5 1.1-2.3 4.1-6.4 6.9-8.5 2-1.5 5.1-2.7 5.1 1.1 0 .8-.5 6.5-.8 7.4-1.1 3.8-4.9 4.8-8.3 4.2 5.9 1 7.4 4.4 4.2 7.8-6.1 6.3-8.8-1.6-9.5-3.7-.1-.4-.2-.6-.3-.8 0 .2-.1.4-.3.8-.8 2.1-3.5 10-9.5 3.7-3.2-3.4-1.7-6.8 4.2-7.8-3.4.6-7.2-.4-8.3-4.2-.3-.9-.8-6.6-.8-7.4 0-3.8 3.1-2.6 5.1-1.1Z" transform="scale(.64) translate(6.75 2.4)" />
            </svg>
          ) : link.icon === "linkedin" ? (
            <svg viewBox="0 0 24 24" focusable="false"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.74H4.97V9.2h2.96ZM6.45 7.9a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44ZM19.03 18.74h-2.96V14.1c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.77 1.2-1.77 2.44v4.72H9.8V9.2h2.84v1.3h.04c.4-.75 1.37-1.54 2.81-1.54 3 0 3.55 1.98 3.55 4.55Z" /></svg>
          ) : link.icon === "facebook" ? (
            <svg viewBox="0 0 24 24" focusable="false"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" /></svg>
          ) : (
            <svg viewBox="0 0 24 24" focusable="false"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-7.4L5.6 22H2.46l8.16-9.33L.8 2h6.4l4.42 6.7Zm-1.1 18h1.73L6.25 4H4.4Z" /></svg>
          )}
        </span>
        <span>{link.name}</span>
      </a>
    ))}

    <a
      class="share-action"
      href={emailUrl}
      rel="nofollow"
      aria-label="Partager par e-mail"
      data-share-destination="email"
    >
      <span class="share-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </span>
      <span>E-mail</span>
    </a>

    <button
      class="share-action"
      type="button"
      data-share-copy
      data-share-url={canonicalUrl}
      aria-label="Copier le lien"
    >
      <span class="share-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <rect x="8" y="8" width="11" height="11" rx="2"></rect>
          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
        </svg>
      </span>
      <span data-share-copy-label>Copier le lien</span>
      <span class="sr-only" aria-live="polite" data-share-copy-status></span>
    </button>
  </div>
  <textarea
    class="share-copy-fallback"
    data-share-copy-fallback
    aria-hidden="true"
    tabindex="-1"
    readonly
  ></textarea>
</section>

<script src={shareLinksScriptUrl} defer></script>

<style>
  .share-panel {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 1.4rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }

  .share-intro {
    min-width: 0;
  }

  .share-intro h2 {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  .share-intro > p:last-child {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.7rem;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    justify-content: flex-end;
  }

  .share-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.65rem;
    padding: 0.5rem 0.72rem;
    background: light-dark(rgba(248, 250, 246, 0.72), rgba(5, 10, 8, 0.72));
    color: var(--muted);
    font: inherit;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 680;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .share-action:hover {
    transform: translateY(-1px);
    border-color: light-dark(rgba(68, 110, 100, 0.5), rgba(142, 229, 209, 0.5));
    background: light-dark(rgba(68, 110, 100, 0.07), rgba(142, 229, 209, 0.07));
    color: var(--text);
  }

  .share-action:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .share-action[data-copy-state="copied"] {
    border-color: light-dark(rgba(61, 96, 74, 0.55), rgba(128, 200, 154, 0.55));
    color: var(--ok);
  }

  .share-action[data-copy-state="error"] {
    border-color: light-dark(rgba(108, 58, 53, 0.55), rgba(224, 120, 111, 0.55));
    color: var(--danger);
  }

  .share-icon {
    display: inline-grid;
    width: 1.3rem;
    height: 1.3rem;
    flex: 0 0 auto;
    place-items: center;
    color: var(--accent);
  }

  .share-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .share-icon--bluesky svg {
    fill: currentColor;
    stroke: none;
  }

  .share-icon--x svg,
  .share-icon--linkedin svg,
  .share-icon--facebook svg {
    fill: currentColor;
    stroke: none;
  }

  .share-copy-fallback {
    position: fixed;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .share-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .share-actions {
      gap: 0.4rem;
    }

    .share-panel:not(.share-panel--article) .share-action {
      width: 2.75rem;
      padding: 0.6rem;
      justify-content: center;
    }

    .share-panel:not(.share-panel--article) .share-action > span:not(.share-icon) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .share-panel--article {
    display: grid;
    gap: 0.9rem;
    margin-top: 2rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 0;
    padding: 1.2rem 0 0;
    scroll-margin-top: 7rem;
  }

  .share-panel--article .share-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
  }

  .share-panel--article .share-intro h2 { font-size: 0.82rem; }
  .share-panel--article .share-intro p { margin: 0; }
  .share-panel--article .share-actions { justify-content: flex-start; }
  .share-panel--article .share-action { color: var(--text); }

  @media (max-width: 560px) {
    .share-panel--article .share-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
      gap: 0.5rem;
    }

    .share-panel--article .share-action {
      justify-content: center;
      padding: 0.6rem 0.4rem;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .share-action { transition: none; }
    .share-action:hover { transform: none; }
  }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackproof.fr/schemas/local-backup-manifest-v2.schema.json",
  "title": "BLACKPROOF Local Backup Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encrypted", "caseId", "files", "missingSnapshotDeliveryIds"],
  "allOf": [
    {
      "if": { "properties": { "encrypted": { "const": true } }, "required": ["encrypted"] },
      "then": { "properties": { "files": { "type": "array", "contains": { "type": "object", "properties": { "path": { "const": "inventory.json" } }, "required": ["path"] } } } }
    }
  ],
  "properties": {
    "version": { "const": "blackproof-local-backup-v2" },
    "localEnvelopeVersion": { "const": 2 },
    "encrypted": { "type": "boolean" },
    "caseId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 252,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^(master\\.json|inventory\\.json|snapshots/[A-Za-z0-9_-]{1,160}\\.json)$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 4500000 }
        }
      }
    },
    "missingSnapshotDeliveryIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 250,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" }
    }
  }
}

---
import BaseLayout from "../layouts/BaseLayout.astro";

const principles = [
  {
    label: "Préparation avant promesse",
    text: "Une réponse cyber n’a de valeur que si elle indique ce qui est déclaré disponible, ce qui manque, ce qui est sensible et ce qui doit rester réservé."
  },
  {
    label: "Données dans votre navigateur",
    text: "Le questionnaire, le dossier et les exports sont préparés sans envoyer vos justificatifs sensibles à BLACKPROOF."
  },
  {
    label: "Limites explicites",
    text: "BLACKPROOF ne promet pas une certification. Il rend le dossier plus lisible, ses limites plus visibles et ses empreintes plus simples à contrôler."
  },
  {
    label: "Formats documentés",
    text: "La méthode, les schémas et les fichiers publics peuvent être lus par une équipe ou un logiciel sans dépendre de BLACKPROOF."
  }
];

const refuses = [
  "Transformer une déclaration cyber en conformité automatique.",
  "Collecter des preuves sensibles sans nécessité claire.",
  "Mélanger réponse client, secrets internes et fichiers non maîtrisés.",
  "Masquer les réserves documentaires derrière un score rassurant.",
  "Enfermer les livrables dans un format qui ne peut pas être exporté et vérifié."
];

const doctrineFlow = [
  ["Répondre", "Formuler une réponse utile, prudente et exploitable."],
  ["Justifier", "Relier la réponse aux documents attendus ou disponibles."],
  ["Protéger", "Isoler les informations partielles, sensibles ou non partageables."],
  ["Partager", "Produire une version client lisible sans compte BLACKPROOF."],
  ["Vérifier", "Contrôler la cohérence, la méthode et l’empreinte de proofpack.json."]
];

const credibility = [
  ["Sécurité", "Données dans votre navigateur, pas de tracker et pas de service tiers pour les polices ou les scripts."],
  ["Méthode", "Questions structurées, justificatifs attendus, réserves visibles et formats versionnés."],
  ["Livrables", "Dossier JSON, réponse fournisseur, registre des justificatifs, plan d’actions et empreinte."]
];
---

<BaseLayout
  title="À propos de BLACKPROOF"
  description="BLACKPROOF prépare des réponses cyber documentées et exportables sans envoyer les justificatifs sensibles vers un serveur."
>
  <section class="hero about-hero">
    <div class="container split">
      <div>
        <p class="eyebrow">À propos</p>
        <h1>BLACKPROOF transforme un questionnaire cyber en dossier prêt à transmettre.</h1>
        <p class="lead">
          Les questionnaires cyber ne manquent pas de réponses. Ils manquent de références documentées,
          de réserves explicites, d’exports propres et de vérification. BLACKPROOF est conçu
          pour préparer ce dossier sans collecter vos justificatifs sensibles.
        </p>
        <div class="actions">
          <a class="button primary" href="/proofpack-example">Voir un dossier livré</a>
          <a class="button" href="/use-cases">Explorer les cas d’usage</a>
          <a class="button" href="/method">Lire la méthode</a>
        </div>
      </div>

      <aside class="command-panel" aria-label="Rôle et limites de BLACKPROOF">
        <p><strong>Rôle du produit</strong></p>
        <p>Préparer les réponses. Protéger les documents sensibles. Exporter un dossier vérifiable.</p>
        <br />
        <p><strong>Limites explicites</strong></p>
        <p>Pas une certification, pas un coffre de secrets, pas une promesse automatique.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container section-header">
      <p class="eyebrow">Principes</p>
      <h2>Quatre principes simples pour traiter un questionnaire client.</h2>
    </div>
    <div class="container grid two">
      {principles.map((item) => (
        <article class="card">
          <p class="kpi">{item.label}</p>
          <h3>{item.label}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container doctrine-band">
      <div>
        <p class="eyebrow">Fonctionnement</p>
        <h2>Répondre. Justifier. Protéger. Partager. Vérifier.</h2>
        <p>
          BLACKPROOF rend visible le chemin entre une question client et un dossier
          que l’on peut relire, transmettre et contrôler.
        </p>
      </div>
      <div class="doctrine-pipeline">
        {doctrineFlow.map(([title, text]) => (
          <article>
            <strong>{title}</strong>
            <span>{text}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container refusal-panel">
      <div>
        <p class="eyebrow">Garde-fous</p>
        <h2>Les refus structurants de BLACKPROOF.</h2>
      </div>
      <ul>
        {refuses.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container grid three">
      {credibility.map(([title, text]) => (
        <article class="card">
          <p class="kpi">Engagement produit</p>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice">
        BLACKPROOF ne donne pas d’avis sur votre conformité. Il aide à préparer
        un dossier cyber plus clair, plus prudent et plus facile à vérifier.
      </div>
    </div>
  </section>

  <style>
    .section-header {
      margin-bottom: 1rem;
    }

    .doctrine-band,
    .refusal-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.58fr) minmax(0, 1.42fr);
      gap: 1rem;
      align-items: start;
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      padding: 1.1rem;
      background:
        linear-gradient(135deg, rgba(121, 216, 200, 0.08), rgba(128, 200, 154, 0.045)),
        rgba(255, 255, 255, 0.03);
      box-shadow: var(--shadow-tight);
    }

    .doctrine-band p,
    .refusal-panel li {
      color: var(--muted);
      line-height: 1.58;
    }

    .doctrine-pipeline {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      background: rgba(8, 11, 12, 0.48);
    }

    .doctrine-pipeline article {
      min-height: 155px;
      border-right: 1px solid var(--line);
      padding: 0.85rem;
    }

    .doctrine-pipeline article:last-child {
      border-right: 0;
    }

    .doctrine-pipeline strong,
    .doctrine-pipeline span {
      display: block;
    }

    .doctrine-pipeline strong {
      color: var(--text);
      font-family: var(--font-display);
    }

    .doctrine-pipeline span {
      margin-top: 1rem;
      color: var(--muted);
      line-height: 1.4;
      font-size: 0.9rem;
    }

    .refusal-panel ul {
      display: grid;
      gap: 0.6rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .refusal-panel li {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.78rem 0.9rem;
      background: rgba(8, 11, 12, 0.48);
    }

    @media (max-width: 980px) {
      .doctrine-band,
      .refusal-panel {
        grid-template-columns: 1fr;
      }

      .doctrine-pipeline {
        grid-template-columns: 1fr;
      }

      .doctrine-pipeline article {
        min-height: auto;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .doctrine-pipeline article:last-child {
        border-bottom: 0;
      }
    }
  </style>
</BaseLayout>

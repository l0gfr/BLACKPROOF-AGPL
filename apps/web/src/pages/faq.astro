---
import BaseLayout from "../layouts/BaseLayout.astro";

const situations = [
  {
    title: "Je reviens avec le même navigateur",
    state: "Accès direct",
    text: "Ouvrez Dossiers locaux, choisissez le dossier puis saisissez sa phrase secrète.",
    href: "/app/cases",
    action: "Voir mes dossiers locaux",
  },
  {
    title: "Je change de navigateur ou d’appareil",
    state: "Sauvegarde requise",
    text: "Il n’existe pas de synchronisation automatique. Restaurez le ZIP chiffré conservé hors de l’ancien appareil.",
    href: "#restaurer",
    action: "Lire la procédure",
  },
  {
    title: "Les données du site ont été effacées",
    state: "Restauration requise",
    text: "Seule une sauvegarde locale complète permet de restaurer les dossiers. Le projet ne possède pas de copie de vos contenus.",
    href: "#sauvegardes",
    action: "Comprendre les sauvegardes",
  },
  {
    title: "J’ai perdu la phrase secrète",
    state: "Irrécupérable",
    text: "BLACKPROOF ne conserve ni la phrase secrète ni une clé de récupération des dossiers. Le contenu chiffré ne peut pas être ouvert.",
    href: "#phrase-secrete",
    action: "Comprendre la protection",
  },
] as const;

const faqGroups = [
  {
    id: "usages",
    eyebrow: "Choisir son usage",
    title: "Revues cyber et audits internes",
    items: [
      {
        question: "Puis-je préparer un audit interne sans questionnaire client ?",
        answer: "Oui. Importez votre grille de contrôle ou saisissez ses questions dans l’application. Documentez les réponses, les références de justificatifs, les réserves et les actions dans un dossier local. Vous pouvez le conserver pour votre revue interne, sans l’envoyer à un tiers.",
      },
      {
        question: "BLACKPROOF réalise-t-il l’audit ou la revue cyber à ma place ?",
        answer: "Non. Il structure la préparation documentaire et signale des incohérences à partir des informations saisies. Il n’inspecte pas vos systèmes, ne lit pas les documents de preuve référencés et ne valide pas la véracité des déclarations. L’appréciation des preuves, le périmètre et les conclusions d’audit restent humains.",
      },
      {
        question: "Qui peut accéder à mes dossiers et à mes exports ?",
        answer: "BLACKPROOF ne reçoit ni ne publie vos fichiers. Les dossiers enregistrés sont chiffrés dans votre profil de navigateur et se déverrouillent avec leur phrase secrète. Un poste compromis ou une session déverrouillée reste un risque. Les exports de transmission et le ZIP maître ne sont pas chiffrés : protégez-les sur votre appareil. Seule la sauvegarde locale complète est chiffrée. Tout partage est une action volontaire de votre part, hors de BLACKPROOF.",
      },
      {
        question: "Puis-je confier mes preuves à un agent IA via BLACKPROOF ?",
        answer: "Cette version ne fournit pas de serveur MCP et ne transmet aucun document à une IA. Un outil local en lecture seule ne garantit pas qu’un agent gardera ses résultats sur l’appareil : un modèle distant pourrait les recevoir. Ne transmettez pas de dossiers sensibles à un agent sans maîtriser ses accès, ses sorties réseau et le traitement de ses résultats.",
      },
    ],
  },
  {
    id: "retrouver-dossiers",
    eyebrow: "Revenir travailler",
    title: "Retrouver ses dossiers",
    items: [
      {
        question: "Comment reprendre mon travail dans BLACKPROOF ?",
        answer: "Ouvrez Dossiers locaux avec le même navigateur et le même profil, puis déverrouillez le dossier avec sa phrase secrète. Aucun compte ni connexion à un service n’est nécessaire.",
      },
      {
        question: "Fermer l’onglet ou quitter le navigateur supprime-t-il mon travail ?",
        answer: "Non. Un dossier enregistré reste dans le stockage IndexedDB de ce profil de navigateur. À la prochaine visite, il doit réapparaître dans Dossiers locaux. Les modifications non sauvegardées avant la fermeture, elles, sont perdues.",
      },
      {
        question: "Qu’entend-on par « même navigateur » ?",
        answer: "Il faut utiliser le même appareil, la même application de navigation et le même profil. Chrome et Edge séparent les données entre leurs profils. Un profil professionnel, un profil personnel et une fenêtre privée possèdent donc des stockages différents.",
      },
      {
        question: "Je suis sur le même ordinateur mais mes dossiers ne s’affichent plus. Que vérifier ?",
        answer: "Vérifiez que vous êtes sur blackproof.fr, dans le bon profil Chrome ou Edge, hors navigation privée, et que les données du site n’ont pas été effacées. Utilisez ensuite Rafraîchir sur Dossiers locaux. Si le stockage a été supprimé, restaurez votre sauvegarde chiffrée.",
      },
      {
        question: "Puis-je retrouver mes dossiers depuis mon téléphone ?",
        answer: "Non. Les navigateurs mobiles ne sont pas pris en charge actuellement et les dossiers ne sont pas synchronisés. Utilisez Chrome ou Edge Desktop et restaurez une sauvegarde locale complète si vous changez d’appareil.",
      },
      {
        question: "Pourquoi le titre complet du dossier n’apparaît-il pas avant déverrouillage ?",
        answer: "Le titre métier, les parties, les questions et les réponses restent chiffrés. Seul un repère local facultatif, choisi par vous et explicitement non sensible, peut être visible dans la liste avant saisie de la phrase secrète.",
      },
    ],
  },
  {
    id: "logiciel-libre",
    eyebrow: "Logiciel libre",
    title: "Un logiciel ouvert, des dossiers locaux.",
    items: [
      {
        question: "Que permet la licence AGPL de BLACKPROOF ?",
        answer: "Vous pouvez utiliser, étudier, modifier et redistribuer BLACKPROOF sous AGPL-3.0-only. La licence complète et le code source sont accessibles depuis la page Logiciel libre.",
      },
      {
        question: "Faut-il un compte pour utiliser BLACKPROOF ?",
        answer: "Non. La création, l’import, le chiffrement, les exports et la vérification fonctionnent directement dans le navigateur.",
      },
      {
        question: "Le projet peut-il restaurer un dossier effacé ?",
        answer: "Non. Les dossiers restent dans votre navigateur. Leur restauration dépend de votre sauvegarde chiffrée et de sa phrase secrète.",
      },
    ],
  },
  {
    id: "phrase-secrete",
    eyebrow: "Chiffrement local",
    title: "Phrase secrète et verrouillage",
    items: [
      {
        question: "Où ma phrase secrète est-elle enregistrée ?",
        answer: "Elle n’est pas enregistrée par BLACKPROOF. Elle sert localement à dériver la clé de chiffrement du dossier. Après verrouillage, rechargement ou expiration de la session de travail, elle doit être saisie à nouveau.",
      },
      {
        question: "Que se passe-t-il si je perds la phrase secrète ?",
        answer: "Le dossier devient irrécupérable. BLACKPROOF ne possède ni copie serveur, ni clé maîtresse, ni mécanisme permettant de contourner le chiffrement. Conservez la phrase secrète dans un gestionnaire de mots de passe adapté à votre organisation.",
      },
      {
        question: "Pourquoi le dossier se verrouille-t-il tout seul ?",
        answer: "Une page déverrouillée efface son état lisible après 15 minutes sans interaction ou après une minute prolongée en arrière-plan. Cette mesure limite l’exposition d’un dossier laissé ouvert sur un poste partagé ou déverrouillé.",
      },
      {
        question: "La phrase secrète protège-t-elle aussi la sauvegarde téléchargée ?",
        answer: "Oui. La sauvegarde locale complète est chiffrée et sa restauration exige une phrase secrète. Le fichier ZIP doit tout de même être protégé, sauvegardé et géré comme un actif sensible.",
      },
      {
        question: "Puis-je utiliser la même phrase secrète pour tous mes dossiers ?",
        answer: "C’est techniquement possible mais déconseillé. Une phrase distincte par dossier réduit l’impact d’une divulgation. Utilisez un gestionnaire de mots de passe et une procédure interne de transmission ou de continuité adaptée.",
      },
    ],
  },
  {
    id: "sauvegardes",
    eyebrow: "Continuité",
    title: "Sauvegarder et restaurer",
    items: [
      {
        question: "Comment créer une sauvegarde exploitable ?",
        answer: "Ouvrez le dossier, enregistrez les changements, allez à la section Sauvegardes puis choisissez Sauvegarde locale complète. Vérifiez le message de complétude et confirmez que le fichier blackproof-local-backup.zip a bien été téléchargé.",
      },
      {
        question: "Que contient une sauvegarde locale complète ?",
        answer: "Elle contient le dossier maître chiffré et les copies locales de dossiers clients archivées qui sont encore disponibles. BLACKPROOF indique si la sauvegarde est complète ou si certaines copies archivées manquent.",
      },
      {
        question: "Où conserver le fichier de sauvegarde ?",
        answer: "Conservez au moins une copie hors de l’appareil utilisé pour travailler, dans un emplacement chiffré et sauvegardé selon la politique de votre organisation. Ne placez pas la phrase secrète en clair à côté du ZIP.",
      },
      {
        question: "Comment restaurer sur un nouvel appareil ?",
        answer: "Ouvrez Dossiers locaux, cliquez sur Restaurer une sauvegarde, sélectionnez le ZIP puis renseignez la phrase secrète demandée. En cas de conflit avec un dossier existant, BLACKPROOF demande aussi les éléments nécessaires pour vérifier et remplacer sans affaiblir le chiffrement.",
      },
      {
        question: "Le bouton « Protéger le stockage sur cet appareil » remplace-t-il une sauvegarde ?",
        answer: "Non. Il demande au navigateur de réduire le risque d’éviction automatique. Il ne protège pas contre un effacement manuel du profil, une panne, une perte de l’appareil ou une politique d’entreprise supprimant les données locales.",
      },
      {
        question: "Pourquoi effacer les données locales si rien n’est envoyé ?",
        answer: "Les dossiers sauvegardés restent dans ce navigateur. L’action « Effacer les données locales » (Panic Wipe) permet de les supprimer, par exemple avant de céder un poste. Elle demande une confirmation explicite. Conservez une sauvegarde chiffrée pour pouvoir les restaurer. Elle ne supprime ni les fichiers téléchargés ni le presse-papiers, et ne garantit pas un effacement physique du disque.",
      },
      {
        question: "Dois-je tester mes sauvegardes ?",
        answer: "Oui. Une sauvegarde non testée n’est pas une garantie de reprise. Utilisez un profil de navigateur distinct ou un poste de test, restaurez le ZIP, vérifiez l’ouverture avec la phrase secrète et contrôlez la présence du dossier maître et des copies archivées attendues.",
      },
    ],
  },
  {
    id: "confidentialite",
    eyebrow: "Périmètre",
    title: "Données, navigateurs et assistance",
    items: [
      {
        question: "Mes questionnaires et preuves sont-ils envoyés à BLACKPROOF ?",
        answer: "Non. Aucun questionnaire, document de preuve ou dossier n’est envoyé à BLACKPROOF. L’import, le traitement, le chiffrement, les sauvegardes et la vérification se font localement dans le navigateur. Télécharger un export enregistre un fichier sur votre appareil. Si vous décidez ensuite de le transmettre, vous le faites vous-même, hors de BLACKPROOF, par le canal de votre choix.",
      },
      {
        question: "Quels navigateurs sont pris en charge ?",
        answer: "La version actuelle est qualifiée sur Chrome Desktop et Edge Desktop. Firefox, Safari et les navigateurs mobiles ne sont pas pris en charge actuellement.",
      },
      {
        question: "Le support peut-il me demander mon questionnaire ou ma phrase secrète ?",
        answer: "Non. Ne transmettez jamais une phrase secrète, un dossier client complet ou une preuve sensible pour obtenir de l’aide. Décrivez le problème avec des informations non sensibles et, si nécessaire, un exemple fictif.",
      },
      {
        question: "Mes dossiers sont-ils synchronisés entre appareils ou collègues ?",
        answer: "Non. BLACKPROOF ne synchronise et n’héberge aucun dossier. Pour changer d’appareil, transférez vous-même une sauvegarde chiffrée puis restaurez-la localement. Pour un destinataire, préparez une version client relue, téléchargez-la et transmettez-la séparément. Une version client ne remplace pas la sauvegarde de votre dossier de travail.",
      },
    ],
  },
] as const;
---

<BaseLayout
  title="FAQ : logiciel libre, dossiers locaux et sauvegardes | BLACKPROOF"
  description="Utiliser BLACKPROOF sans compte : retrouver, déverrouiller, sauvegarder et restaurer ses dossiers chiffrés, sans envoi de documents au serveur."
  mainSchema="webpage"
>
  <section class="hero faq-hero">
    <div class="container faq-hero-grid">
      <div>
        <p class="eyebrow">Aide et FAQ</p>
        <h1>Vos dossiers locaux, de la première ouverture à la sauvegarde.</h1>
        <p class="lead">
          BLACKPROOF est un logiciel libre sous AGPL-3.0-only, utilisable sans compte.
          Vos dossiers sont chiffrés dans votre navigateur, sans envoi de documents ni synchronisation serveur.
        </p>
        <div class="actions">
          <a class="button primary" href="/app/cases">Voir mes dossiers locaux</a>
          <a class="button" href="#sauvegardes">Sauvegarder et restaurer</a>
          <a class="button" href="/security">Sécurité des données</a>
        </div>
      </div>

      <aside class="faq-truth" aria-label="Résumé du fonctionnement actuel">
        <p>À retenir en 20 secondes</p>
        <dl>
          <div><dt>Accès</dt><dd>libre, sans compte</dd></div>
          <div><dt>Vos dossiers</dt><dd>dans ce navigateur</dd></div>
          <div><dt>Clé d’ouverture</dt><dd>phrase secrète</dd></div>
          <div><dt>Changement d’appareil</dt><dd>ZIP chiffré requis</dd></div>
        </dl>
        <strong>Vos dossiers restent dans votre navigateur.</strong>
      </aside>
    </div>
  </section>

  <section class="section situation-section">
    <div class="container section-header">
      <p class="eyebrow">Diagnostic rapide</p>
      <h2>Quel est votre cas ?</h2>
    </div>
    <div class="container situation-grid">
      {situations.map((situation) => (
        <article>
          <span>{situation.state}</span>
          <h3>{situation.title}</h3>
          <p>{situation.text}</p>
          <a href={situation.href}>{situation.action} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section guide-section" aria-labelledby="guide-title">
    <div class="container section-header">
      <p class="eyebrow">Parcours illustré</p>
      <h2 id="guide-title">Les trois écrans à connaître.</h2>
      <p>Captures réalisées avec des données fictives. Aucun dossier client réel n’est affiché.</p>
    </div>

    <div class="container guide-grid">
      <figure class="guide-shot">
        <img
          src="/guides/faq-dossiers-locaux.png"
          alt="Liste vide des dossiers locaux BLACKPROOF avec état de persistance du stockage du navigateur"
          width="1280"
          height="720"
          loading="lazy"
        />
        <figcaption>
          <span>01</span>
          <div><strong>Dossiers locaux</strong><p>C’est le point de retour normal sur le même navigateur.</p></div>
        </figcaption>
      </figure>

      <figure class="guide-shot">
        <img
          src="/guides/faq-phrase-secrete.png"
          alt="Écran de création d’un dossier BLACKPROOF demandant une phrase secrète et sa confirmation"
          width="1280"
          height="720"
          loading="lazy"
        />
        <figcaption>
          <span>02</span>
          <div><strong>Phrase secrète</strong><p>Elle chiffre le dossier et doit être conservée hors de BLACKPROOF.</p></div>
        </figcaption>
      </figure>

      <figure class="guide-shot">
        <img
          src="/guides/faq-sauvegarde.png"
          alt="Section Sauvegardes d’un dossier fictif avec le bouton Sauvegarde locale complète"
          width="1280"
          height="720"
          loading="lazy"
        />
        <figcaption>
          <span>03</span>
          <div><strong>Sauvegarde complète</strong><p>Le ZIP chiffré permet la reprise sur un autre appareil.</p></div>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-layout">
      <aside class="faq-index" aria-labelledby="faq-index-title">
        <p class="eyebrow" id="faq-index-title">Dans cette FAQ</p>
        <nav aria-label="Catégories de la FAQ">
          {faqGroups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
        </nav>
        <div class="index-note">
          <strong>Avant une manipulation risquée</strong>
          <p>Téléchargez une sauvegarde locale complète et vérifiez sa présence hors du navigateur.</p>
        </div>
      </aside>

      <div class="faq-groups">
        {faqGroups.map((group) => (
          <section class="faq-group" id={group.id}>
            <p class="eyebrow">{group.eyebrow}</p>
            <h2>{group.title}</h2>
            <div class="faq-list">
              {group.items.map((item, index) => (
                <details open={index === 0}>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section checklist-section" id="restaurer">
    <div class="container checklist-panel">
      <div>
        <p class="eyebrow">Procédure recommandée</p>
        <h2>Avant de fermer un dossier important.</h2>
        <p>Cette vérification prend quelques minutes et évite de confondre stockage navigateur et sauvegarde opérationnelle.</p>
      </div>
      <ol>
        <li><span>1</span><p><strong>Enregistrer</strong> les changements dans l’éditeur.</p></li>
        <li><span>2</span><p><strong>Télécharger</strong> une sauvegarde locale complète.</p></li>
        <li><span>3</span><p><strong>Déplacer</strong> le ZIP vers un emplacement chiffré hors de l’appareil.</p></li>
        <li><span>4</span><p><strong>Conserver</strong> la phrase secrète séparément dans un gestionnaire adapté.</p></li>
        <li><span>5</span><p><strong>Tester</strong> périodiquement une restauration dans un profil distinct.</p></li>
      </ol>
    </div>
  </section>

  <style>
    .faq-hero {
      padding-bottom: 1.5rem;
    }

    .faq-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(330px, 0.62fr);
      gap: 1.4rem;
      align-items: center;
    }

    .faq-truth,
    .situation-grid article,
    .guide-shot,
    .faq-group,
    .faq-index,
    .checklist-panel {
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      background:
        linear-gradient(180deg, light-dark(rgba(248, 250, 246, 0.96), rgba(22, 29, 27, 0.96)), light-dark(rgba(248, 250, 246, 0.96), rgba(8, 11, 12, 0.96)));
      box-shadow: var(--shadow-tight);
    }

    .faq-truth {
      padding: 1rem;
    }

    .faq-truth > p,
    .faq-truth > strong {
      font-family: var(--font-display);
    }

    .faq-truth > p {
      margin: 0;
      color: var(--accent);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .faq-truth dl {
      display: grid;
      gap: 0.55rem;
      margin: 1rem 0;
    }

    .faq-truth dl div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.55rem;
    }

    .faq-truth dt {
      color: var(--muted);
    }

    .faq-truth dd {
      margin: 0;
      color: var(--text);
      font-weight: 780;
      text-align: right;
    }

    .faq-truth > strong {
      display: block;
      border-left: 3px solid var(--warning);
      padding: 0.75rem;
      background: light-dark(rgba(118, 87, 44, 0.07), rgba(245, 182, 91, 0.07));
      color: var(--text);
      line-height: 1.4;
    }

    .section-header > p:last-child {
      max-width: 760px;
      color: var(--muted);
    }

    .situation-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .situation-grid article {
      display: flex;
      min-height: 16rem;
      flex-direction: column;
      padding: 1rem;
    }

    .situation-grid article > span {
      align-self: flex-start;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      padding: 0.3rem 0.55rem;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .situation-grid h3 {
      margin: 1rem 0 0;
      font-size: 1.14rem;
    }

    .situation-grid p {
      color: var(--muted);
      line-height: 1.55;
    }

    .situation-grid a {
      margin-top: auto;
      color: var(--text);
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 760;
    }

    .guide-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .guide-shot {
      overflow: hidden;
      margin: 0;
    }

    .guide-shot img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      border-bottom: 1px solid var(--line-strong);
      object-fit: cover;
      object-position: top;
      background: var(--panel);
    }

    .guide-shot figcaption {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.8rem;
      align-items: start;
      padding: 0.9rem;
    }

    .guide-shot figcaption > span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .guide-shot figcaption strong,
    .guide-shot figcaption p {
      display: block;
    }

    .guide-shot figcaption p {
      margin: 0.28rem 0 0;
      color: var(--muted);
      font-size: 0.84rem;
      line-height: 1.45;
    }

    .faq-layout {
      display: grid;
      grid-template-columns: minmax(220px, 0.3fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .faq-index {
      position: sticky;
      top: 1rem;
      padding: 1rem;
    }

    .faq-index nav {
      display: grid;
      gap: 0.45rem;
    }

    .faq-index nav a {
      border-left: 2px solid var(--line-strong);
      padding: 0.45rem 0.65rem;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .faq-index nav a:hover {
      border-left-color: var(--accent);
      color: var(--text);
    }

    .index-note {
      margin-top: 1rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.75rem;
      background: light-dark(rgba(24, 66, 46, 0.025), rgba(255, 255, 255, 0.025));
    }

    .index-note p {
      margin-bottom: 0;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .faq-groups {
      display: grid;
      gap: 1rem;
    }

    .faq-group {
      scroll-margin-top: 1rem;
      padding: clamp(1rem, 2vw, 1.3rem);
    }


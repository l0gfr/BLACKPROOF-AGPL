---
import AnalysisCard from "../../components/editorial/AnalysisCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedAnalyses } from "../../lib/analyses";

const analyses = await getPublishedAnalyses();
const featured = analyses.find((entry) => entry.data.featured) ?? analyses[0];
const remaining = featured ? analyses.filter((entry) => entry.id !== featured.id) : [];
const principles = [
  ["Faits", "Éléments directement étayés par une source primaire ou plusieurs sources fiables."],
  ["Hypothèses", "Possibilités non démontrées, accompagnées des éléments nécessaires pour trancher."],
  ["Inconnues", "Points que les informations publiques ne permettent pas encore d’établir."],
  ["Corrections", "Toute mise à jour substantielle est datée et signalée dans l’analyse."],
] as const;
---

<BaseLayout
  title="Analyses cyber - BLACKPROOF"
  description="Analyses cyber sourcées sur les fuites de données, intrusions, rançongiciels, vulnérabilités et incidents de chaîne d’approvisionnement."
  canonicalPath="/analyses"
  mainSchema="none"
>
  <section class="hero analyses-hero">
    <div class="container analyses-hero-grid">
      <div>
        <p class="eyebrow">Analyses cyber</p>
        <h1>Établir les faits avant de raconter l’attaque.</h1>
        <p class="lead">
          Fuites de données, intrusions, rançongiciels et vulnérabilités examinés à partir de
          sources identifiables. Les faits, les hypothèses et les inconnues restent séparés.
        </p>
        <div class="actions">
          <a class="button" href="/analyses/feed.xml">Suivre par RSS</a>
          <a class="button" href="/method">Voir la méthode BLACKPROOF</a>
        </div>
      </div>

      <aside class="editorial-contract" aria-labelledby="editorial-contract-title">
        <p class="kpi">Contrat de lecture</p>
        <h2 id="editorial-contract-title">Une conclusion doit rester réfutable.</h2>
        <p>
          Chaque analyse publie ses sources, sa date de vérification, son niveau de confiance
          et les limites de ce que les éléments disponibles permettent d’affirmer.
        </p>
      </aside>
    </div>
  </section>

  <section class="section analyses-list" aria-labelledby="latest-analyses">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Publications</p>
          <h2 id="latest-analyses">Dernières analyses</h2>
        </div>
        <p>{analyses.length} publication{analyses.length > 1 ? "s" : ""} validée{analyses.length > 1 ? "s" : ""}</p>
      </div>

      {featured ? (
        <div class="analysis-grid">
          <AnalysisCard entry={featured} featured />
          {remaining.map((entry) => <AnalysisCard entry={entry} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h3>La rubrique est prête.</h3>
          <p>La première analyse sera publiée après vérification complète de ses sources.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section doctrine-section" aria-labelledby="editorial-doctrine">
    <div class="container doctrine-grid">
      <div>
        <p class="eyebrow">Doctrine éditoriale</p>
        <h2 id="editorial-doctrine">Pas de certitude fabriquée.</h2>
        <p class="lead">
          Une revendication d’attaquant, une capture d’écran ou un chiffre repris en boucle
          constituent des signaux. Ils ne deviennent pas automatiquement des faits.
        </p>
      </div>
      <div class="principles">
        {principles.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .analyses-hero {
    padding-bottom: 4.5rem;
  }

  .analyses-hero-grid,
  .doctrine-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: end;
  }

  .editorial-contract {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
    background:
      linear-gradient(155deg, light-dark(rgba(62, 105, 97, 0.07), rgba(129, 218, 203, 0.07)), transparent 72%),
      light-dark(rgba(248, 250, 246, 0.86), rgba(12, 17, 16, 0.86));
    box-shadow: var(--shadow-tight);
  }

  .editorial-contract h2 {
    font-size: 1.35rem;
  }

  .editorial-contract p:last-child {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .analyses-list {
    border-top: 1px solid var(--line);
    background: light-dark(rgba(248, 250, 246, 0.18), rgba(4, 7, 7, 0.18));
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .section-heading > p {
    margin: 0 0 0.85rem;
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .analysis-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty-state {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .empty-state p {
    margin-bottom: 0;
    color: var(--muted);
  }

  .doctrine-section {
    border-top: 1px solid var(--line);
  }

  .doctrine-grid {
    align-items: start;
  }

  .principles {
    display: grid;
    gap: 0.7rem;
  }

  .principles article {
    border-left: 2px solid var(--accent);
    padding: 0.2rem 0 0.2rem 1rem;
  }

  .principles article:nth-child(2) {
    border-color: var(--accent-violet);
  }

  .principles article:nth-child(3) {
    border-color: var(--accent-gold);
  }

  .principles article:nth-child(4) {
    border-color: var(--accent-blue);
  }

  .principles h3,
  .principles p {
    margin: 0;
  }

  .principles p {
    margin-top: 0.25rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .analyses-hero-grid,
    .doctrine-grid,
    .analysis-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

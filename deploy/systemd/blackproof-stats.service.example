[Unit]
Description=Generate the private BLACKPROOF GoAccess report
After=apache2.service

[Service]
Type=oneshot
User=blackproof-stats
Group=blackproof-stats
SupplementaryGroups=adm
UMask=0027
Environment=LC_TIME=C
ExecStart=/usr/local/libexec/blackproof-generate-stats
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
KeyringMode=private
RemoveIPC=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/log/apache2
ReadWritePaths=/var/www/html/blackproof-stats
MemoryMax=256M
TasksMax=32
